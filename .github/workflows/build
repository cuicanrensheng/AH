name: Build TV Live APK
on:
  push:
    branches: [ main ]
    # 可选：取消注释下面，只在 app目录改动才触发构建，减少无效运行
    # paths:
    #   - 'app/**'
    #   - 'build.gradle'
    #   - 'gradle/**'
    #   - '.github/workflows/build.yml'
  workflow_dispatch:

permissions:
  contents: write
  actions: write

jobs:
  build:
    runs-on: ubuntu-22.04
    permissions:
      contents: write
      actions: write
    steps:
      - name: 拉取仓库代码
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: 删除历史Workflow运行记录（跳过当前任务，防403）
        uses: actions/github-script@v7
        with:
          script: |
            const owner = context.repo.owner;
            const repo = context.repo.repo;
            const currentRunId = context.runId;
            let page = 1;
            const pageSize = 100;
            while (true) {
              const res = await github.rest.actions.listWorkflowRunsForRepo({
                owner,
                repo,
                per_page: pageSize,
                page: page
              });
              const runs = res.data.workflow_runs;
              if (runs.length === 0) break;
              
              for (const run of runs) {
                if (run.id === currentRunId) {
                  console.log(`⏭️ 跳过当前运行任务 #${run.id}`);
                  continue;
                }
                try {
                  await github.rest.actions.deleteWorkflowRun({
                    owner,
                    repo,
                    run_id: run.id
                  });
                  console.log(`✅ 清理旧构建 #${run.id}`);
                } catch (err) {
                  console.warn(`⚠️ 删除 #${run.id} 失败: ${err.message}`);
                }
                // 简易限流，防止github api 429
                await new Promise(r => setTimeout(r, 300));
              }
              page++;
            }
            console.log("✅ 历史构建清理完成");

      - name: 设置 JDK 17
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'
          cache: gradle

      - name: 缓存 Gradle wrapper
        uses: actions/cache@v4
        with:
          path: ~/.gradle/wrapper
          key: gradle-wrapper-${{ hashFiles('gradle/wrapper/gradle-wrapper.properties') }}

      - name: 生成 Gradle Wrapper
        run: gradle wrapper --gradle-version 9.5.1

      - name: 赋予脚本权限
        run: chmod +x gradlew

      - name: 编译 Release APK
        run: ./gradlew assembleRelease --no-build-cache --stacktrace

      - name: 生成 update.json
        run: |
          VERSION_CODE=${{ github.run_number }}
          VERSION_NAME="1.0.$VERSION_CODE"
          DOWNLOAD_URL="https://github.com/${{ github.repository }}/releases/download/v$VERSION_CODE/app-release.apk"
          cat > update.json << EOF
          {
            "versionCode": $VERSION_CODE,
            "versionName": "$VERSION_NAME",
            "message": "自动更新版本",
            "downloadUrl": "$DOWNLOAD_URL"
          }
          EOF

      - name: 上传 APK Artifact
        uses: actions/upload-artifact@v4
        with:
          name: TVLive-直播APP
          path: app/build/outputs/apk/release/*.apk

      - name: 上传更新配置文件
        uses: actions/upload-artifact@v4
        with:
          name: update-config
          path: update.json

      - name: 创建 GitHub Release
        uses: softprops/action-gh-release@v2
        with:
          tag_name: v${{ github.run_number }}
          name: 自动发布 v${{ github.run_number }}
          files: |
            app/build/outputs/apk/release/app-release.apk
            update.json
          overwrite: true # 覆盖同名tag（可选，注意风险）
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
