<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:background="@drawable/hyberry_shape_alert_bg"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:textColor="@color/hyberry_gray22"
            android:textSize="17sp" />

        <View
            android:id="@+id/title_divider"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="visible" />

        <TextView
            android:id="@+id/message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:layout_marginTop="20dp"
            android:singleLine="false"
            android:textColor="@color/hyberry_gray66"
            android:textSize="13sp" />
        <View
            android:id="@+id/message_divider"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="20dp"
            android:background="@color/hyberry_divider"
            android:visibility="visible" />

        <CheckBox
            android:id="@+id/remeber_cb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|left"
            android:layout_marginLeft="10dp"
            android:text="@string/hyberry_alert_window_permission_huya_remeber"
            android:textColor="@color/hyberry_gray66"
            android:textSize="14sp"
            android:visibility="gone" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="17dp"
            android:layout_marginRight="15dp"
            android:gravity="center_vertical|right"
            android:orientation="horizontal">


            <View
                android:id="@+id/button_divider_a"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@color/hyberry_divider" />

            <TextView
                android:id="@+id/button_neutral"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/hyberry_selector_alert_btn_bg"
                android:paddingBottom="5dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingTop="5dp"
                android:text="取消"
                android:textColor="@color/hyberry_gray66"
                android:textSize="14sp" />

            <View
                android:id="@+id/button_divider_b"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@color/hyberry_divider" />

            <TextView
                android:id="@+id/button_positive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/hyberry_selector_alert_btn_bg"
                android:paddingBottom="5dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingTop="5dp"
                android:text="确定"
                android:textColor="@color/hyberry_text_orange"
                android:textSize="14sp" />

            <View
                android:id="@+id/button_divider_c"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@color/hyberry_divider" />

        </LinearLayout>

    </LinearLayout>
</RelativeLayout>