<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
             android:layout_width="match_parent"
             android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="310dp"
        android:layout_height="416dp"
        android:background="@drawable/hyberry_fragment_bg">
        <com.huya.berry.gamesdk.widgets.CommonTopBar
            android:id="@+id/top_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/hyberry_end_live_bg">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="直播已结束"
                android:textColor="@color/hyberry_black"
                android:textSize="18sp"
                android:layout_marginTop="65dp"
                android:layout_marginBottom="2dp"/>
            <TextView
                android:id="@+id/tv_loading"
                android:layout_width="wrap_content"
                android:layout_height="178dp"
                android:text="直播数据统计中，请稍候..."
                android:gravity="center"
                android:textColor="@color/hyberry_color_666666"
                android:textSize="12sp"/>
            <TextView
                android:id="@+id/tv_live_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="02:35:45"
                android:textColor="@color/hyberry_black"
                android:textSize="26sp"
                android:textStyle="bold"
                android:visibility="gone"/>
            <TableLayout
                android:id="@+id/ll_live_data"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="30dp"
                android:visibility="gone">
                <TableRow
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/tv_peak_viewer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1245"
                            android:textColor="@color/hyberry_color_222222"
                            android:textSize="18sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="人气峰值"
                            android:textColor="@color/hyberry_color_666666"
                            android:textSize="12sp"/>
                    </LinearLayout>
                    <View
                        android:layout_width="0.5dp"
                        android:layout_height="34dp"
                        android:layout_gravity="center"
                        android:background="@color/hyberry_color_D3E0E7"
                        android:layout_marginLeft="15dp"
                        android:layout_marginRight="15dp"/>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/tv_gift_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1000万"
                            android:textColor="@color/hyberry_color_222222"
                            android:textSize="18sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="礼物金豆"
                            android:textColor="@color/hyberry_color_666666"
                            android:textSize="12sp"/>
                    </LinearLayout>
                </TableRow>
                <TableRow
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/tv_new_fans"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1.3万"
                            android:textColor="@color/hyberry_color_222222"
                            android:textSize="18sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="新增订阅"
                            android:textColor="@color/hyberry_color_666666"
                            android:textSize="12sp"/>
                    </LinearLayout>
                    <View
                        android:layout_width="0.5dp"
                        android:layout_height="34dp"
                        android:layout_gravity="center"
                        android:background="@color/hyberry_color_D3E0E7"
                        android:layout_marginLeft="15dp"
                        android:layout_marginRight="15dp"/>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/tv_live_share"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3452"
                            android:textColor="@color/hyberry_color_222222"
                            android:textSize="18sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="获得分享"
                            android:textColor="@color/hyberry_color_666666"
                            android:textSize="12sp"/>
                    </LinearLayout>
                </TableRow>
            </TableLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tv_exit"
                    android:layout_width="98dp"
                    android:layout_height="30dp"
                    android:text="退出"
                    android:textColor="@color/hyberry_color_222222"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:background="@drawable/hyberry_end_live_btn"
                    android:layout_marginRight="20dp"/>
                <TextView
                    android:id="@+id/tv_back"
                    android:layout_width="98dp"
                    android:layout_height="30dp"
                    android:text="返回首页"
                    android:textColor="@color/hyberry_color_222222"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:background="@drawable/hyberry_end_live_btn"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>