<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:id="@+id/ll_live_list"
        android:orientation="vertical"
        android:layout_width="310dp"
        android:layout_height="406dp"
        android:layout_gravity="center"
        android:background="@drawable/hyberry_fragment_bg">
        <com.huya.berry.gamesdk.widgets.CommonTopBar
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/srl_live_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.huya.android.support.v7.widget.RecyclerView
                    android:id="@+id/rv_live_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="vertical"
                    android:scrollbarStyle="outsideOverlay"
                    android:fadeScrollbars="false"
                    android:clipToPadding="false"/>
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
            <RelativeLayout
                android:id="@+id/rl_anthor_recruit_small"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:clickable="true"
                android:focusable="true"
                android:background="#F2FFF3D3"
                android:visibility="gone">
                <ImageView
                    android:layout_width="27dp"
                    android:layout_height="20dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/hyberry_anchor_recruit_horn_small"
                    android:layout_marginLeft="7dp"
                    android:visibility="gone"/>
                <com.huya.berry.gamesdk.widgets.MarqueeTextView
                    android:id="@+id/tv_anthor_recruit_small"
                    android:layout_width="180dp"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:textColor="#996823"
                    android:textSize="11sp"
                    android:layout_marginLeft="38dp"
                    android:visibility="gone"/>
                <ImageView
                    android:layout_width="6dp"
                    android:layout_height="9dp"
                    android:layout_centerVertical="true"
                    android:layout_toRightOf="@+id/tv_anthor_recruit_small"
                    android:src="@drawable/hyberry_anchor_recruit_target_small"
                    android:layout_marginLeft="6dp"
                    android:visibility="gone"/>
                <TextView
                    android:id="@+id/tv_start_live_small"
                    android:layout_width="68dp"
                    android:layout_height="20dp"
                    android:layout_centerVertical="true"
                    android:layout_alignParentRight="true"
                    android:text="一键开播"
                    android:textColor="@color/hyberry_white"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:background="@drawable/hyberry_start_live_btn_tip"
                    android:layout_marginRight="7dp"/>
                <TextView
                    android:id="@+id/tv_default_small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="朋友、粉丝、礼物等你来"
                    android:textColor="#996823"
                    android:textSize="12sp"
                    android:layout_marginLeft="14dp"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/fl_component_small"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone"
                android:background="@drawable/hyberry_shape_component_bg">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="1dp"
                    android:layout_marginLeft="8dp"/>
                <com.huya.berry.gamesdk.widgets.MarqueeTextView
                    android:id="@+id/tv_component_small"
                    android:layout_width="170dp"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:textColor="#ffffff"
                    android:textSize="11sp"
                    android:layout_marginTop="5dp"
                    android:layout_marginLeft="38dp"/>
                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_centerVertical="true"
                    android:padding="4dp"
                    android:layout_toRightOf="@+id/tv_component_small"
                    android:layout_marginTop="6dp"
                    android:src="@drawable/hyberry_component_target"
                    android:layout_marginLeft="2dp"/>
                <TextView
                    android:id="@+id/tv_component_start_live_small"
                    android:layout_width="68dp"
                    android:layout_height="20dp"
                    android:layout_centerVertical="true"
                    android:layout_alignParentRight="true"
                    android:layout_marginTop="4dp"
                    android:text="一键开播"
                    android:textColor="@color/hyberry_color_a22f2f"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:background="@drawable/hyberry_component_start_live_btn"
                    android:layout_marginRight="8dp"/>
            </RelativeLayout>
        </FrameLayout>
        <LinearLayout
            android:id="@+id/ll_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">
            <ImageView
                android:layout_width="61dp"
                android:layout_height="55dp"
                android:src="@drawable/hyberrry_empty_list_icon"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hyberry_empty_live_list"
                android:textColor="@color/hyberry_color_cdcdcd"
                android:textSize="14sp"
                android:layout_marginTop="5dp"/>
        </LinearLayout>
    </LinearLayout>
    <include
        layout="@layout/hyberry_layout_small_window"
        android:id="@+id/ll_small_window"
        android:visibility="gone"/>
</FrameLayout>