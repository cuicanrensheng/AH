<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
             android:layout_width="match_parent"
             android:layout_height="match_parent">
    <LinearLayout
        android:id="@+id/ll_live_list"
        android:orientation="vertical"
        android:layout_width="470dp"
        android:layout_height="290dp"
        android:layout_gravity="center"
        android:background="@drawable/hyberry_fragment_bg">
        <com.huya.berry.gamesdk.widgets.CommonTopBar
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">
            <FrameLayout
                android:layout_width="170dp"
                android:layout_height="match_parent"
                android:background="@drawable/hyberry_banner_land">
                <LinearLayout
                    android:id="@+id/ll_start_live"
                    android:layout_width="146dp"
                    android:layout_height="38dp"
                    android:orientation="horizontal"
                    android:layout_gravity="right|bottom"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingBottom="8dp"
                    android:background="@drawable/hyberry_start_live_btn_small"
                    android:layout_marginBottom="9dp"
                    android:layout_marginLeft="14dp">
                </LinearLayout>
            </FrameLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <FrameLayout
                    android:id="@+id/fl_anthor_recruit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginTop="3dp"
                    android:visibility="gone">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:src="@drawable/hyberry_anchor_recruit_bg"
                        android:layout_marginTop="5dp"
                        android:layout_marginLeft="16dp"/>
                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="31dp"
                        android:src="@drawable/hyberry_anchor_recruit_horn"/>
                    <com.huya.berry.gamesdk.widgets.MarqueeTextView
                        android:layout_width="211dp"
                        android:layout_height="wrap_content"
                        android:textColor="@color/hyberry_white"
                        android:textSize="12sp"
                        android:layout_marginTop="10dp"
                        android:layout_marginLeft="44dp"/>
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="right"
                        android:src="@drawable/hyberry_anchor_recruit_target"
                        android:layout_marginTop="9dp"
                        android:layout_marginRight="4dp"/>
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/fl_anthor_component"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone"
                    android:layout_marginTop="3dp">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/hyberry_component_bg"
                        android:layout_marginRight="12dp"
                        android:layout_marginLeft="24dp"/>
                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginLeft="10dp"/>
                    <com.huya.berry.gamesdk.widgets.MarqueeTextView
                        android:layout_width="211dp"
                        android:layout_height="wrap_content"
                        android:textColor="@color/hyberry_white"
                        android:textSize="12sp"
                        android:layout_marginTop="10dp"
                        android:layout_marginLeft="52dp"/>
                    <ImageView
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:layout_gravity="right"
                        android:padding="4dp"
                        android:src="@drawable/hyberry_component_target"
                        android:layout_marginTop="9dp"
                        android:layout_marginRight="16dp"/>
                </FrameLayout>
                <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                    android:id="@+id/srl_live_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.huya.android.support.v7.widget.RecyclerView
                        android:id="@+id/rv_live_list"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scrollbars="vertical"
                        android:scrollbarStyle="outsideOverlay"
                        android:fadeScrollbars="false"
                        android:clipToPadding="false"/>
                </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
                <LinearLayout
                    android:id="@+id/ll_empty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:visibility="gone">
                    <ImageView
                        android:layout_width="61dp"
                        android:layout_height="55dp"
                        android:src="@drawable/hyberrry_empty_list_icon"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hyberry_empty_live_list"
                        android:textColor="@color/hyberry_color_cdcdcd"
                        android:textSize="14sp"
                        android:layout_marginTop="5dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <include
        layout="@layout/hyberry_layout_small_window_land"
        android:id="@+id/ll_small_window"
        android:visibility="gone"/>
</FrameLayout>