<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
             android:layout_width="match_parent"
             android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="470dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/hyberry_fragment_bg"
        android:orientation="vertical">
        <com.huya.berry.gamesdk.widgets.CommonTopBar
            android:id="@+id/ctb_title_bar"
                                                    android:layout_width="match_parent"
                                                    android:layout_height="wrap_content"/>

        <LinearLayout android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:background="@drawable/hyberry_login_bg"
                      android:orientation="vertical">

            <TextView android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:layout_gravity="center_horizontal"
                      android:text="@string/hyberry_login_tips"
                      android:textColor="@color/hyberry_color_999999"
                      android:textSize="12sp"
                      android:layout_marginTop="15dp"/>

            <LinearLayout android:layout_width="280dp"
                          android:layout_height="wrap_content"
                          android:layout_gravity="center_horizontal"
                          android:layout_marginTop="13dp"
                          android:background="@drawable/hyberry_common_frame"
                          android:orientation="horizontal">
                <EditText android:id="@+id/edit_phone"
                          android:layout_width="0dp"
                          android:layout_height="36dp"
                          android:layout_weight="1"
                          android:background="@null"
                          android:drawableLeft="@drawable/hyberry_selector_phone_icon"
                          android:drawablePadding="8dp"
                          android:gravity="center_vertical"
                          android:hint="@string/hyberry_login_phone_hint"
                          android:paddingLeft="8dp"
                          android:paddingRight="8dp"
                          android:text=""
                          android:textColor="@color/hyberry_color_333333"
                          android:textColorHint="@color/hyberry_color_999999"
                          android:textSize="14sp"
                          android:maxLength="11"
                          android:inputType="number"
                          android:imeOptions="flagNoExtractUi"/>

                <ImageView android:id="@+id/iv_delete"
                           android:layout_width="wrap_content"
                           android:layout_height="wrap_content"
                           android:layout_gravity="center_vertical"
                           android:layout_marginRight="9dp"
                           android:src="@drawable/hyberry_delete"/>
            </LinearLayout>

            <LinearLayout android:layout_width="280dp"
                          android:layout_height="wrap_content"
                          android:layout_gravity="center_horizontal"
                          android:layout_marginTop="10dp"
                          android:orientation="horizontal">
                <EditText android:id="@+id/edit_verify_code"
                          android:layout_width="0dp"
                          android:layout_height="36dp"
                          android:layout_weight="1"
                          android:background="@drawable/hyberry_common_frame"
                          android:drawableLeft="@drawable/hyberry_selector_code_icon"
                          android:drawablePadding="8dp"
                          android:gravity="center_vertical"
                          android:hint="请输入验证码"
                          android:paddingLeft="8dp"
                          android:paddingRight="8dp"
                          android:text=""
                          android:textColor="@color/hyberry_color_333333"
                          android:textColorHint="@color/hyberry_color_999999"
                          android:textSize="14sp"
                          android:inputType="number"
                          android:imeOptions="flagNoExtractUi"/>

                <TextView android:id="@+id/tv_get_verify_code"
                          android:layout_width="88dp"
                          android:layout_height="36dp"
                          android:layout_gravity="center_vertical"
                          android:layout_marginLeft="10dp"
                          android:background="@drawable/hyberry_common_button_bg"
                          android:gravity="center"
                          android:text="获取验证码"
                          android:textColor="@color/hyberry_color_white"
                          android:textSize="12sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">
                <CheckBox android:id="@+id/cb_rule"
                          android:layout_width="wrap_content"
                          android:layout_height="wrap_content"
                          android:button="@null"
                          android:checked="false"
                          android:drawableLeft="@drawable/hyberry_common_checkbox"
                          android:drawablePadding="5dp"
                          android:paddingLeft="0dp"
                          android:text="@string/hyberry_is_agree_rule"
                          android:textColor="@color/hyberry_color_666666"
                          android:textSize="12sp"/>
                <TextView
                    android:id="@+id/tv_login_rule"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hyberry_login_rule"
                    android:textColor="@color/hyberry_color_4A90E2"
                    android:textSize="12sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hyberry_login_dot"
                    android:textColor="@color/hyberry_color_666666"
                    android:textSize="12sp"/>
                <TextView
                    android:id="@+id/tv_login_private_rule"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hyberry_login_private_rule"
                    android:textColor="@color/hyberry_color_4A90E2"
                    android:textSize="12sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hyberry_he"
                    android:textColor="@color/hyberry_color_666666"
                    android:textSize="12sp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_live_rule"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hyberry_live_rule"
                android:textColor="@color/hyberry_color_4A90E2"
                android:layout_gravity="center_horizontal"
                android:textSize="12sp"/>
            <TextView android:id="@+id/tv_login"
                      android:layout_width="280dp"
                      android:layout_height="38dp"
                      android:layout_gravity="center_horizontal"
                      android:layout_marginBottom="23dp"
                      android:layout_marginTop="14dp"
                      android:background="@drawable/hyberry_common_button_circle_bg"
                      android:gravity="center"
                      android:text="登录"
                      android:textColor="@color/hyberry_color_white"
                      android:textSize="16sp"
            />
        </LinearLayout>
    </LinearLayout>
</ScrollView>