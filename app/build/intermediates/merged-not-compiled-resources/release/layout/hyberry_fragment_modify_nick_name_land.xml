<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
             android:layout_width="match_parent"
             android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="470dp"
        android:layout_height="290dp"
        android:background="@drawable/hyberry_fragment_bg">

        <com.huya.berry.gamesdk.widgets.CommonTopBar
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:layout_width="470dp"
            android:layout_height="253dp">
            <ScrollView
                android:id="@+id/sv_modify_nickname"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="10dp">
                    <LinearLayout
                        android:layout_width="280dp"
                        android:layout_height="36dp"
                        android:layout_marginTop="23dp"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:orientation="horizontal"
                        android:layout_gravity="center_horizontal"
                        android:background="@drawable/hyberry_modify_nickname_input_bg">
                        <EditText
                            android:id="@+id/et_nickname"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:gravity="center_vertical"
                            android:textColor="@color/hyberry_color_333333"
                            android:textSize="14sp"
                            android:hint="@string/modify_nick_name_input_nickname"
                            android:textColorHint="@color/hyberry_gray33_40"
                            android:maxLength="20"
                            android:singleLine="true"
                            android:maxLines="1"
                            android:imeOptions="flagNoExtractUi"/>
                        <ImageView
                            android:id="@+id/iv_clear"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:focusable="true"
                            android:clickable="true"
                            android:layout_gravity="center_vertical"
                            android:src="@drawable/hyberry_delete_nickname_icon"/>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tv_edit_nickname_cost_tips"
                        android:layout_width="280dp"
                        android:layout_height="wrap_content"
                        android:textColor="@color/hyberry_color_999999"
                        android:textSize="12sp"
                        android:text="本次修改昵称需要花费"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="4dp"/>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_gravity="center_horizontal">
                        <FrameLayout
                            android:id="@+id/fl_pay_sliver_btn"
                            android:layout_width="132dp"
                            android:layout_height="30dp"
                            android:focusable="true"
                            android:clickable="true"
                            android:background="@drawable/hyberry_anchor_modify_nickname_btn"
                            android:layout_marginTop="13dp"
                            android:layout_marginBottom="8dp"
                            android:visibility="gone">
                            <TextView
                                android:duplicateParentState="true"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:drawableLeft="@drawable/hyberry_pay_bean"
                                android:layout_gravity="center"
                                android:textColor="@drawable/hyberry_resolution_text_color"
                                android:textSize="12sp"
                                android:text="100,000银豆"/>
                            <ImageView
                                android:duplicateParentState="true"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/hyberry_modify_nickname_pay_selected"
                                android:layout_gravity="bottom|right"/>
                        </FrameLayout>
                        <FrameLayout
                            android:id="@+id/fl_pay_gold_btn"
                            android:layout_width="132dp"
                            android:layout_height="30dp"
                            android:focusable="true"
                            android:clickable="true"
                            android:layout_marginLeft="16dp"
                            android:background="@drawable/hyberry_anchor_modify_nickname_btn"
                            android:layout_marginTop="13dp"
                            android:layout_marginBottom="8dp"
                            android:visibility="gone">
                            <TextView
                                android:duplicateParentState="true"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:drawableLeft="@drawable/hyberry_pay_bean"
                                android:layout_gravity="center"
                                android:textColor="@drawable/hyberry_resolution_text_color"
                                android:textSize="12sp"
                                android:text="10,000金豆"/>
                            <ImageView
                                android:duplicateParentState="true"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/hyberry_modify_nickname_pay_selected"
                                android:layout_gravity="bottom|right"/>
                        </FrameLayout>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tv_save_nick"
                        android:layout_width="280dp"
                        android:layout_height="36dp"
                        android:layout_marginLeft="15dp"
                        android:layout_marginRight="15dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/hyberry_save_nickname_btn_bg"
                        android:gravity="center"
                        android:text="保存"
                        android:textColor="@color/hyberry_color_white"
                        android:textSize="15sp"/>
                    <TextView
                        android:id="@+id/tv_modify_rule"
                        android:layout_width="280dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:textColor="@color/hyberry_color_999999"
                        android:textSize="10sp"
                        android:layout_marginTop="19dp"/>
                </LinearLayout>
            </ScrollView>

            <ViewStub
                android:id="@+id/vs_network_exception"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout="@layout/hyberry_layout_network_error" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>