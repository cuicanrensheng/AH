<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
             android:layout_width="match_parent"
             android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="330dp"
        android:layout_height="164dp"
        android:layout_gravity="center"
        android:background="@drawable/hyberry_fragment_bg"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:text="@string/hyberry_input_live_title"
            android:textColor="@color/hyberry_color_333333"
            android:textSize="16sp"/>

        <LinearLayout
            android:layout_width="280dp"
            android:layout_height="36dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/hyberry_common_frame"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/edit_live_title"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@null"
                android:gravity="center_vertical"
                android:hint="@string/hyberry_live_title_hint"
                android:imeOptions="flagNoExtractUi"
                android:maxLength="20"
                android:maxLines="1"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:singleLine="true"
                android:textColor="@color/hyberry_color_333333"
                android:textColorHint="@color/hyberry_color_999999"
                android:textSize="14sp"/>

            <ImageView
                android:id="@+id/iv_delete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginRight="9dp"
                android:src="@drawable/hyberry_delete"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_start_live"
            android:layout_width="177dp"
            android:layout_height="38dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/hyberry_start_live_btn_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="立即开播"
            android:textColor="@color/hyberry_color_white"
            android:textSize="16sp"/>
    </LinearLayout>
</FrameLayout>