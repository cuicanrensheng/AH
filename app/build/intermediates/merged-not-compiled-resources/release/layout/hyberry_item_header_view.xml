<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="309dp"
    android:layout_height="160dp"
    android:background="@drawable/hyberry_banner"
    android:paddingBottom="8dp">
    <LinearLayout
        android:id="@+id/ll_start_live"
        android:layout_width="146dp"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:layout_gravity="center_horizontal|bottom"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:paddingBottom="8dp"
        android:background="@drawable/hyberry_start_live_btn_small"
        android:layout_marginBottom="4dp">
    </LinearLayout>
    <FrameLayout
        android:id="@+id/fl_anthor_recruit"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginTop="3dp"
        android:visibility="gone">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:src="@drawable/hyberry_anchor_recruit_bg_port"
            android:layout_marginTop="5dp"
            android:layout_marginLeft="28dp"/>
        <ImageView
            android:layout_width="40dp"
            android:layout_height="31dp"
            android:src="@drawable/hyberry_anchor_recruit_horn"
            android:layout_marginLeft="11dp"/>
        <com.huya.berry.gamesdk.widgets.MarqueeTextView
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="60dp"
            android:layout_marginTop="10dp"
            android:textColor="@color/hyberry_white"
            android:textSize="12sp"/>
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="right"
            android:src="@drawable/hyberry_anchor_recruit_target"
            android:layout_marginTop="9dp"
            android:layout_marginRight="4dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/fl_anthor_component"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        android:layout_marginTop="3dp">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginRight="12dp"
            android:background="@drawable/hyberry_component_bg"
            android:layout_marginLeft="28dp"/>
        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginLeft="11dp"/>
        <com.huya.berry.gamesdk.widgets.MarqueeTextView
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="60dp"
            android:layout_marginTop="10dp"
            android:textColor="@color/hyberry_white"
            android:textSize="12sp"/>
        <ImageView
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:layout_gravity="right"
            android:src="@drawable/hyberry_component_target"
            android:padding="4dp"
            android:layout_marginTop="9dp"
            android:layout_marginRight="16dp"/>
    </FrameLayout>
</FrameLayout>