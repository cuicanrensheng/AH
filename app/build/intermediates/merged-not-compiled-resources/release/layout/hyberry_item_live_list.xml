<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:orientation="vertical"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:clickable="true"
              android:focusable="true">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:background="@drawable/hyberry_item_live_list_cover_bg">
        <ImageView
            android:id="@+id/iv_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/hyberry_default_cover"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="27dp"
            android:orientation="horizontal"
            android:layout_gravity="left|bottom"
            android:gravity="bottom"
            android:paddingLeft="6dp"
            android:paddingRight="4dp"
            android:paddingBottom="5dp"
            android:background="@drawable/hyberry_item_live_list_mask">
            <TextView
                android:id="@+id/tv_anchor_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="主播名字"
                android:textSize="10sp"
                android:textColor="@color/hyberry_color_white"
                android:ellipsize="marquee"
                android:singleLine="true"
                android:layout_marginRight="10dp"/>
            <ImageView
                android:id="@+id/iv_audience"
                android:layout_width="8dp"
                android:layout_height="9dp"
                android:src="@drawable/hyberry_audience_count_icon"
                android:layout_marginBottom="2dp"/>
            <TextView
                android:id="@+id/tv_audience_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12.8万"
                android:textSize="10sp"
                android:textColor="@color/hyberry_color_white"
                android:layout_marginLeft="3dp"/>
        </LinearLayout>
    </FrameLayout>
    <TextView
        android:id="@+id/tv_live_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="7日重播，8日17：00重播"
        android:textSize="12sp"
        android:textColor="@color/hyberry_color_222222"
        android:singleLine="true"
        android:ellipsize="marquee"/>
</LinearLayout>