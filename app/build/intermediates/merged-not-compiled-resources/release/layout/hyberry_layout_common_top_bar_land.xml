<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="37dp">
    <ImageView
        android:id="@+id/iv_logo"
        android:layout_width="78dp"
        android:layout_height="24dp"
        android:layout_centerVertical="true"
        android:layout_alignParentLeft="true"
        android:src="@drawable/hyberry_huya_logo"
        android:layout_marginLeft="12dp"
        android:visibility="visible"/>
    <LinearLayout
        android:id="@+id/ll_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_alignParentLeft="true"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginLeft="2dp"
        android:visibility="gone">
        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="28dp"
            android:layout_height="36dp"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/hyberry_back_icon"
            android:padding="10dp"/>
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/hyberry_color_666666"
            android:textSize="14sp"
            android:layout_marginLeft="9dp"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/ll_kaihei"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginRight="10dp"
        android:layout_toLeftOf="@+id/ll_resolution"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginLeft="2dp"
        android:visibility="gone">
        <ImageView
            android:id="@+id/iv_kaihei"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/hyberry_kaihei_btn"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/ll_resolution"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toLeftOf="@+id/ll_avatar"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginRight="13dp"
        android:visibility="gone">
        <LinearLayout
            android:id="@+id/ll_switch_resolution"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/hyberry_resolution_bg"
            android:paddingLeft="12dp"
            android:paddingRight="5dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="高清"
                android:textColor="@color/hyberry_color_555555"
                android:textSize="12sp"
                android:layout_marginRight="5dp"/>
            <ImageView
                android:id="@+id/down_icon"
                android:layout_width="20dp"
                android:layout_height="10dp"
                android:src="@drawable/hyberry_target_down_icon"
                android:padding="2dp"
                android:layout_marginTop="1dp"/>
            <ImageView
                android:id="@+id/up_icon"
                android:layout_width="20dp"
                android:layout_height="12dp"
                android:src="@drawable/hyberry_target_up_icon"
                android:padding="2dp"
                android:visibility="gone"
                android:layout_marginTop="1dp"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/ll_avatar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_alignParentRight="true"
        android:orientation="horizontal"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:layout_marginRight="46dp"
        android:visibility="gone">
        <ImageView
            android:id="@+id/iv_avatar"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/hyberry_unlogin_icon"/>
        <TextView
            android:id="@+id/tv_nickname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="登录"
            android:textSize="12sp"
            android:textColor="@color/hyberry_color_999999"
            android:maxWidth="60dp"
            android:maxLines="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginLeft="5dp"/>
    </LinearLayout>
    <View
        android:layout_width="0.5dp"
        android:layout_height="16dp"
        android:layout_centerVertical="true"
        android:layout_alignParentRight="true"
        android:background="@color/hyberry_color_fofofo"
        android:layout_marginRight="37dp"/>
    <ImageView
        android:id="@+id/iv_close"
        android:layout_width="20.5dp"
        android:layout_height="20.5dp"
        android:layout_centerVertical="true"
        android:layout_alignParentRight="true"
        android:src="@drawable/hyberry_close_icon"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginRight="8.4dp"
        android:padding="5dp"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_alignParentBottom="true"
        android:background="@color/hyberry_color_E1E1E1"/>
</RelativeLayout>