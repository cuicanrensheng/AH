<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:orientation="vertical"
              android:layout_width="204dp"
              android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_kaihei_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="7dp"
        android:background="@drawable/hyberry_kaihei_arrow"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/hyberry_kaihei_toast_bg">
        <TextView
            android:id="@+id/tv_kaihei_toast"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginTop="8dp"
            android:textColor="@color/hyberry_color_E3E3E3"
            android:text="登录虎牙账号，即可获得直播开黑特权，开播后观众可通过直播间一键加入队伍！登录虎牙账号，即可获得直播开黑特权，开播后观众可通过直播间一键加入队伍！"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:paddingBottom="3dp"
            android:textSize="9sp"/>
    </RelativeLayout>

</LinearLayout>