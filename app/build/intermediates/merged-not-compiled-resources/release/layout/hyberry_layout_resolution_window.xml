<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:orientation="vertical"
              android:layout_width="174dp"
              android:layout_height="122dp"
              android:background="@drawable/hyberry_resolution_bg"
              android:padding="1dp">

    <TextView
        android:id="@+id/tv_resolution_title"
        android:layout_width="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_height="20dp"
        android:layout_centerVertical="true"
        android:textColor="@color/hyberry_color_999999"
        android:text="请选择开播画质"
        android:textSize="9sp"
        android:singleLine="true"
        android:ellipsize="end"
        android:layout_marginLeft="11dp"
        android:layout_marginRight="20dp"/>
    <ListView
        android:id="@+id/lv_resolution"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@color/hyberry_transparent"/>
</LinearLayout>