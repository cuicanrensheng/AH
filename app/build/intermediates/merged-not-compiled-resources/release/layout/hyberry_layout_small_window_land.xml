<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="470dp"
    android:layout_height="290dp"
    android:layout_gravity="center">
    <RelativeLayout
        android:layout_width="470dp"
        android:layout_height="wrap_content"
        android:background="@drawable/hyberry_fragment_bg2">
        <com.huya.berry.gamesdk.widgets.CommonTopBar
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </RelativeLayout>
    <FrameLayout
        android:layout_width="470dp"
        android:layout_height="252dp"
        android:background="@drawable/hyberry_banner_large"
        android:paddingBottom="8dp">
        <LinearLayout
            android:id="@+id/ll_start_live"
            android:layout_width="221dp"
            android:layout_height="55dp"
            android:orientation="horizontal"
            android:layout_gravity="center_horizontal|bottom"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:paddingBottom="8dp"
            android:background="@drawable/hyberry_start_live_btn_large"
            android:layout_marginBottom="15dp">
        </LinearLayout>
        <FrameLayout
            android:id="@+id/fl_anthor_recruit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginTop="3dp"
            android:visibility="gone">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:src="@drawable/hyberry_anchor_recruit_bg_land"
                android:layout_marginTop="5dp"
                android:layout_marginLeft="25dp"/>
            <ImageView
                android:layout_width="40dp"
                android:layout_height="31dp"
                android:src="@drawable/hyberry_anchor_recruit_horn"
                android:layout_marginLeft="9dp"/>
            <com.huya.berry.gamesdk.widgets.MarqueeTextView
                android:layout_width="376dp"
                android:layout_height="wrap_content"
                android:textColor="@color/hyberry_white"
                android:textSize="12sp"
                android:layout_marginTop="10dp"
                android:layout_marginLeft="60dp"/>
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="right"
                android:src="@drawable/hyberry_anchor_recruit_target"
                android:layout_marginTop="9dp"
                android:layout_marginRight="4dp"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/fl_anthor_component"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            android:layout_marginTop="3dp">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/hyberry_component_bg"
                android:layout_marginLeft="28dp"/>
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginLeft="11dp"/>
            <com.huya.berry.gamesdk.widgets.MarqueeTextView
                android:layout_width="376dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="60dp"
                android:layout_marginTop="10dp"
                android:textColor="@color/hyberry_white"
                android:textSize="12sp"/>
            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_gravity="right"
                android:src="@drawable/hyberry_component_target"
                android:padding="4dp"
                android:layout_marginTop="9dp"
                android:layout_marginRight="4dp"/>
        </FrameLayout>
    </FrameLayout>
</LinearLayout>