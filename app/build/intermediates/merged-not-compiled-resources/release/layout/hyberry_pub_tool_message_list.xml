<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <com.huya.berry.sdklive.living.messageboard.ui.ChatListBrowser
        android:id="@+id/channel_chat_browser"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:cacheColorHint="@color/hyberry_transparent"
        android:divider="@color/hyberry_transparent"
        android:dividerHeight="0dp"
        android:listSelector="@color/hyberry_transparent"
        android:scrollbars="none" />

    <TextView
        android:id="@+id/channel_chat_new_msg"
        android:layout_width="90dp"
        android:layout_height="20dp"
        android:layout_marginBottom="5dp"
        android:layout_marginLeft="6dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/hyberry_shape_bg_white_60_radius_10"
        android:drawableRight="@drawable/hyberry_live_item_new_msg"
        android:gravity="center_vertical|left"
        android:paddingLeft="15dp"
        android:paddingRight="10dp"
        android:textColor="@color/hyberry_black"
        android:textSize="10sp"
        android:singleLine="true"
        android:maxLines="1"
        android:visibility="gone" />
</LinearLayout>