<?xml version="1.0" encoding="utf-8"?>
<com.huya.berry.sdklive.liveTool.SessionLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <FrameLayout
        android:id="@+id/msg_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/tool_main_btn"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@null"
            android:clickable="true"
            android:src="@drawable/hyberry_start_live_floating_icon"
            android:padding="5dp"/>
        <!--腾讯版要改 android:src="@drawable/hyberry_float_window_play"-->
        <TextView
            android:id="@+id/tool_news_num"
            android:layout_width="wrap_content"
            android:layout_height="13dp"
            android:layout_alignTop="@+id/tool_main_btn"
            android:layout_alignLeft="@+id/tool_main_btn"
            android:background="@drawable/hyberry_pub_black_round_corner_bg"
            android:gravity="center"
            android:text="0"
            android:textColor="@color/hyberry_white"
            android:textSize="9sp"
            android:minWidth="22dp"
            android:paddingLeft="3dp"
            android:paddingRight="3dp"
            android:layout_marginLeft="29dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignLeft="@+id/tool_main_btn"
            android:layout_alignRight="@id/tool_main_btn"
            android:layout_alignBottom="@+id/tool_main_btn"
            android:gravity="center">
            <TextView
                android:id="@+id/tool_user_num"
                android:layout_width="wrap_content"
                android:layout_height="12dp"
                android:background="@drawable/hyberry_user_num_bg"
                android:drawableLeft="@drawable/hyberry_user_num_icon"
                android:gravity="center"
                android:text="0"
                android:textColor="@color/hyberry_color_white"
                android:textSize="8sp"
                android:maxWidth="40dp"
                android:minWidth="22dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"/>
        </LinearLayout>

        <ImageView
            android:id="@+id/iv_aaronli"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_alignBottom="@+id/tool_main_btn"
            android:layout_alignRight="@+id/tool_main_btn"
            android:layout_marginBottom="5dp"
            android:layout_marginRight="5dp"
            android:src="@drawable/hyberry_msg_preview_aaronli"
            android:visibility="gone"/>
    </RelativeLayout>


</com.huya.berry.sdklive.liveTool.SessionLinearLayout>