<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout  xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/playview_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/danmu_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
        </FrameLayout>
        <com.huya.berry.sdkplayer.floats.view.HyberryVideoView
            android:id="@+id/floating_video_playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">
        </com.huya.berry.sdkplayer.floats.view.HyberryVideoView>
        <ImageView
            android:id="@+id/floating_video_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/hyberry_floating_bg_game"/>

        <ProgressBar
            android:id="@+id/floating_loading"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:visibility="visible"
            android:indeterminateDrawable="@drawable/hyberry_floating_player_loading"/>

        <com.huya.berry.sdkplayer.floats.view.PromptTextView
            android:id="@+id/floating_prompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:drawablePadding="8dp"
            android:drawableTop="@drawable/hyberry_floating_video_fresh"
            android:gravity="center"
            android:text="@string/hyberry_floating_click_to_refresh"
            android:textColor="@color/hyberry_white_transparency_90_percent"
            android:textSize="13dp"
            android:visibility="gone"/>

</RelativeLayout>
