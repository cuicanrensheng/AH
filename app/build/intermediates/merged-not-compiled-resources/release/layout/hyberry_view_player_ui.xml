<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 水印 -->
    <ImageView
        android:id="@+id/water_mark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/hyberry_floating_video_water_mark"
        android:visibility="gone"/>

    <LinearLayout
        android:id="@+id/ll_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:orientation="horizontal"
        android:layout_marginLeft="2dp">
        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="28dp"
            android:layout_height="36dp"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/hyberry_floating_back"
            android:padding="5dp"/>
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="韩服王者局对战各大职业选手！"
            android:layout_marginTop="7dp"
            android:textColor="@color/hyberry_color_white"
            android:textSize="15sp"
            android:layout_marginLeft="4dp"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/ll_anchor"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:orientation="horizontal"
        android:layout_gravity="left"
        android:layout_marginTop="40dp"
        android:layout_marginLeft="40dp">
        <ImageView
            android:id="@+id/iv_avatar"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/hyberry_unlogin_icon"/>
        <TextView
            android:id="@+id/tv_anchor_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginLeft="6dp"
            android:text="主播名字"
            android:textSize="10sp"
            android:textColor="@color/hyberry_color_F7F7F7"
            android:ellipsize="marquee"
            android:singleLine="true"
            android:layout_marginRight="10dp"/>
        <ImageView
            android:id="@+id/iv_audience"
            android:layout_width="8dp"
            android:layout_height="9dp"
            android:layout_marginTop="7dp"
            android:layout_marginLeft="20dp"
            android:src="@drawable/hyberry_floating_count"
            android:layout_marginBottom="2dp"/>
        <TextView
            android:id="@+id/tv_audience_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="12.8万"
            android:textSize="10sp"
            android:textColor="@color/hyberry_color_white"
            android:layout_marginLeft="3dp"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/ll_subscribe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:orientation="horizontal"
        android:layout_marginTop="9dp"
        android:layout_marginRight="16dp">
        <TextView android:id="@+id/tv_subscribe"
            android:layout_width="60dp"
            android:layout_height="24dp"
            android:background="@drawable/hyberry_shape_bg_ffa200_radius_25"
            android:drawableLeft="@drawable/hyberry_floating_subscribe"
            android:gravity="center_vertical"
            android:drawablePadding="4dp"
            android:paddingLeft="7dp"
            android:paddingRight="4dp"
            android:text="订阅"
            android:textColor="@color/hyberry_white"
            android:textSize="12sp"/>
        <TextView android:id="@+id/tv_has_subscribe"
            android:layout_width="60dp"
            android:layout_height="24dp"
            android:background="@drawable/hyberry_shape_bg_white_20_radius_25"
            android:gravity="center"
            android:text="已订阅"
            android:textColor="@color/hyberry_white"
            android:visibility="gone"
            android:textSize="12sp"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/floating_right"
        android:layout_width="wrap_content"
        android:layout_height="33dp"
        android:layout_marginLeft="3dp"
        android:layout_marginRight="10dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentRight="true">
        <ImageView
            android:id="@+id/floating_danmu"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/hyberry_floating_danmu_icon"/>
        <TextView
            android:id="@+id/tv_rate"
            android:layout_width="64dp"
            android:layout_height="22dp"
            android:layout_marginLeft="20dp"
            android:background="@drawable/hyberry_video_rate_bg"
            android:gravity="center"
            android:text="@string/hyberry_rate_super"
            android:textSize="12sp"
            android:textColor="@color/hyberry_color_F7F7F7" />
        <ImageView
            android:id="@+id/floating_voice_close"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginLeft="20dp"
            android:src="@drawable/hyberry_floating_voice_icon"/>
        <ImageView
            android:id="@+id/floating_fullScreen"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginLeft="21dp"
            android:src="@drawable/hyberry_floating_full_screen"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/floating_left"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentLeft="true"
        android:layout_marginLeft="12dp"
        android:layout_marginBottom="7dp">
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:id="@+id/floating_send_msg"
            android:layout_marginTop="4dp"
            android:src="@drawable/hyberry_floating_send_msg"
            android:clickable="true"/>
        <EditText
            android:id="@+id/floating_input"
            android:layout_height="30dp"
            android:layout_width="410dp"
            android:layout_weight="1"
            android:background="@drawable/hyberry_shape_bg_white_80_radius_100"
            android:hint="@string/hyberry_barrage_send_tip"
            android:textColorHint="@color/hyberry_color_888888"
            android:imeOptions="actionNone|flagNoExtractUi"
            android:maxLength="20"
            android:singleLine="true"
            android:paddingLeft="13dp"
            android:focusableInTouchMode="false"
            android:textColor="@color/hyberry_white"
            android:visibility="gone"
            android:textSize="12sp" />
    </LinearLayout>

</RelativeLayout>

