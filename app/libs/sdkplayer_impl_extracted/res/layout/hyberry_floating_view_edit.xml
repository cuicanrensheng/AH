<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_alignParentBottom="true"
    android:gravity="bottom"
    android:background="@color/hyberry_transparent"
    android:orientation="vertical"
    android:visibility="visible">

    <TextView
        android:id="@+id/input_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/input_ly"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
       />

    <LinearLayout
        android:id="@+id/input_ly"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@color/hyberry_color_0E0E0E"
        android:layout_alignParentBottom="true"
        android:layout_alignParentLeft="true"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/input_et"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/hyberry_barrage_send_tip"
                android:textColorHint="@color/hyberry_color_888888"
                android:imeOptions="actionNone|flagNoExtractUi"
                android:maxLength="30"
                android:singleLine="true"
                android:paddingLeft="13dp"
                android:textColor="@color/hyberry_white"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_num"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_marginTop="-3dp"
                android:gravity="center"
                android:text="2/10"
                android:textSize="12sp"
                android:textColor="@color/hyberry_color_999999" />

            <TextView
                android:id="@+id/tv_send"
                android:layout_width="70dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="20dp"
                android:gravity="center"
                android:text="发送"
                android:textSize="14sp"
                android:background="@drawable/hyberry_common_button_bg"
                android:textColor="@color/hyberry_color_white" />
        </LinearLayout>

    </LinearLayout>



</RelativeLayout>