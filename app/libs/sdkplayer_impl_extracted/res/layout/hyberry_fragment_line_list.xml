<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/view_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
    </View>
    <LinearLayout
        android:id="@+id/ll_line_list"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_marginTop="130dp"
        android:layout_height="50dp"
        android:layout_gravity="left">
        <TextView
            android:id="@+id/tv_line"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginTop="10dp"
            android:layout_marginLeft="109dp"
            android:gravity="left"
            android:text="线     路："
            android:textSize="16sp"
            android:textColor="@color/hyberry_color_999999"  />
        <com.huya.android.support.v7.widget.RecyclerView
            android:id="@+id/rv_line_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="horizontal"
            android:fadeScrollbars="false"
            android:clipToPadding="false"/>

    </LinearLayout>
    <LinearLayout
        android:id="@+id/ll_rate_list"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_marginTop="190dp"
        android:layout_height="50dp"
        android:layout_gravity="left">

        <TextView
            android:id="@+id/tv_rate"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginTop="10dp"
            android:layout_marginLeft="109dp"
            android:gravity="left"
            android:text="@string/hyberry_rate_title"
            android:textSize="16sp"
            android:textColor="@color/hyberry_color_999999"  />
        <com.huya.android.support.v7.widget.RecyclerView
            android:id="@+id/rv_rate_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="horizontal"
            android:fadeScrollbars="false"
            android:clipToPadding="false"/>

    </LinearLayout>
</FrameLayout>