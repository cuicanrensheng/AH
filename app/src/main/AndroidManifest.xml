<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 电视必需：开机自启 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 电视必需：前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- 电视必需：保持屏幕常亮 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 电视必需：精确闹钟（开机自启用） -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Android 13+ 通知权限（可选） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 移除 SDK 自动合并的手机敏感权限，避免手机隐私风险提示 -->
    <uses-permission android:name="android.permission.MOUNT_UNMOUNT_FILESYSTEMS" tools:node="remove" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.BLUETOOTH" tools:node="remove" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" tools:node="remove" />
    <uses-permission android:name="Manifest.permission.RECORD_AUDIO" tools:node="remove" />

    <application
        android:name=".MyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.TVLive.NoTitle"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:hardwareAccelerated="true"
        android:largeHeap="true">

        <!-- 虎牙 Berry SDK meta-data（name 必须用 SDK 内部读取的 HY_APPID/HY_APPKEY 等，
             否则 SDK 读不到 appid，getLiveData 鉴权失败返回 code=1） -->
        <meta-data
            android:name="NS_APPID"
            android:value="live_android" />
        <meta-data
            android:name="CLIENT_TYPE"
            android:value="adr_game_sdk" />
        <meta-data
            android:name="HY_APPID"
            android:value="@string/hyberry_appid" />
        <meta-data
            android:name="HY_APPKEY"
            android:value="@string/hyberry_appkey" />
        <meta-data
            android:name="HY_VERSION"
            android:value="@string/hyberry_version" />
        <meta-data
            android:name="HY_CHANNEL"
            android:value="@string/hyberry_channel" />

        <!-- 覆盖 SDK 组件的 exported 属性（BerryWebActivity 在 SDK AAR 中不存在，已移除 MissingClass） -->
        <activity
            android:name="com.huya.berry.webview.WebViewActivity"
            android:exported="false"
            tools:node="merge" />

        <meta-data
            android:name="huya_berry_webview_scheme"
            android:value="@string/hyberry_webview_scheme" />
        <meta-data
            android:name="huya_berry_app_name"
            android:value="@string/hyberry_app_name" />

        <!-- 主 Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 崩溃页面 -->
        <activity
            android:name=".CrashActivity"
            android:theme="@android:style/Theme.DeviceDefault.Light.Dialog"
            android:exported="false"
            android:excludeFromRecents="true" />

        <!-- 开机自启接收器 -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- 创维/酷开快速开机唤醒兜底：屏幕点亮 + 用户解锁 -->
            <intent-filter>
                <action android:name="android.intent.action.SCREEN_ON" />
                <action android:name="android.intent.action.USER_PRESENT" />
            </intent-filter>
        </receiver>

        <!-- 延迟启动接收器 -->
        <receiver
            android:name=".BootStartReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.tv.live.START_APP" />
            </intent-filter>
        </receiver>

        <!-- JobScheduler 兜底服务 -->
        <service
            android:name=".BootJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />

        <!-- 开机自启临时前台服务（Android 10+ 后台启动限制兜底） -->
        <service
            android:name=".BootStartForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

    </application>
</manifest>
