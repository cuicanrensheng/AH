<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 存储权限（兼容旧 Android） -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <!-- 安装应用权限 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 开机自启 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- 唤醒锁 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 精确闹钟（BootReceiver 使用） -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- 允许忽略电池优化 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Android 13+ 通知权限 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 🔥 新增：TIF 绑定所需权限 -->
    <uses-permission android:name="android.permission.BIND_TV_INPUT" />

    <application
        android:name=".MyApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.TVLive.NoTitle"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:hardwareAccelerated="true"
        android:largeHeap="true">

        <!-- 虎牙 Berry SDK meta-data（name 必须用 SDK 内部读取的 HY_APPID/HY_APPKEY 等，
             否则 SDK 读不到 appid，getLiveData 鉴权失败返回 code=1） -->
        <meta-data
            android:name="NS_APPID"
            android:value="live_android" />
        <meta-data
            android:name="CLIENT_TYPE"
            android:value="adr_game_sdk" />
        <meta-data
            android:name="HY_APPID"
            android:value="@string/hyberry_appid" />
        <meta-data
            android:name="HY_APPKEY"
            android:value="@string/hyberry_appkey" />
        <meta-data
            android:name="HY_VERSION"
            android:value="@string/hyberry_version" />
        <meta-data
            android:name="HY_CHANNEL"
            android:value="@string/hyberry_channel" />

        <!-- 覆盖 SDK 组件的 exported 属性 -->
        <activity
            android:name="com.huya.berry.webview.WebViewActivity"
            android:exported="false"
            tools:node="merge" />

        <activity
            android:name="com.huya.berry.webview.BerryWebActivity"
            android:exported="false"
            tools:node="merge" />
        <meta-data
            android:name="huya_berry_webview_scheme"
            android:value="@string/hyberry_webview_scheme" />
        <meta-data
            android:name="huya_berry_app_name"
            android:value="@string/hyberry_app_name" />

        <!-- 主 Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 崩溃页面 -->
        <activity
            android:name=".CrashActivity"
            android:theme="@android:style/Theme.DeviceDefault.Light.Dialog"
            android:exported="false"
            android:excludeFromRecents="true" />

        <!-- 开机自启接收器 -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- 创维/酷开快速开机唤醒兜底：屏幕点亮 + 用户解锁 -->
            <intent-filter>
                <action android:name="android.intent.action.SCREEN_ON" />
                <action android:name="android.intent.action.USER_PRESENT" />
            </intent-filter>
        </receiver>

        <!-- 延迟启动接收器 -->
        <receiver
            android:name=".BootStartReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.tv.live.START_APP" />
            </intent-filter>
        </receiver>

        <!-- JobScheduler 兜底服务 -->
        <service
            android:name=".BootJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />

        <!-- 开机自启临时前台服务（Android 10+ 后台启动限制兜底） -->
        <service
            android:name=".BootStartForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <!-- FileProvider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- ==================== 移除被排除的 SDK AAR 注入的不需要组件 ====================
             由于构建时通过 exclude 黑名单移除了 sdkplayer/sdklive/sdkcamera
             等 AAR 的类和资源，但它们的 AndroidManifest.xml 仍会通过
             manifest merger 合并进来，导致其声明的 Activity/Service
             引用的 @style/AppTheme.Live.Living2 等资源找不到，
             AAPT 链接失败。通过 tools:node="remove" 在合并阶段直接删除
             这些不需要的组件声明，即可解除对已排除资源的依赖。
             ================================================================ -->

        <!-- SDK 原生播放器：悬浮窗 PlayerActivity / 竖屏 PlayerActivity（完全使用 Media3，不需要） -->
        <activity
            android:name="com.huya.berry.sdkplayer.floats.view.PlayerActivity"
            tools:node="remove" />
        <activity
            android:name="com.huya.berry.sdkplayer.floats.view.PortraitPlayerActivity"
            tools:node="remove" />
        <!-- SDK 相机回声测试页（推流/测试专用，纯播放不用） -->
        <activity
            android:name="com.huya.berry.sdkcamera.CameraEchoActivity"
            tools:node="remove" />
        <!-- SDK 直播工具箱服务（推流专用，纯播放不用） -->
        <service
            android:name="com.huya.berry.sdklive.liveTool.LiveToolService"
            tools:node="remove" />

        <!-- ==================== TIF 集成新增部分 ==================== -->

        <!-- 1. TIF 配置引导界面 -->
        <activity
            android:name=".tv.SetupActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.tv.action.CHANNEL_SETUP" />
            </intent-filter>
        </activity>

        <!-- 2. TIF 核心服务 -->
        <!-- ✅ 注意：这里已改成了 .tv.LiveTvInputService -->
        <service
            android:name=".tv.LiveTvInputService"
            android:permission="android.permission.BIND_TV_INPUT"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.tv.TvInputService" />
            </intent-filter>
            <meta-data
                android:name="android.media.tv.input"
                android:resource="@xml/tv_input" />
        </service>

    </application>
</manifest>