<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 选中状态：蓝色 -->
    <item android:color="#40A9FF" android:state_selected="true" />
    <item android:color="#40A9FF" android:state_activated="true" />
    <!-- 按下状态：蓝色（触摸时） -->
    <item android:color="#40A9FF" android:state_pressed="true" />
    <!-- 焦点状态：蓝色（遥控器） -->
    <item android:color="#40A9FF" android:state_focused="true" />
    <!-- 默认：白色 -->
    <item android:color="#FFFFFF" />
</selector>
