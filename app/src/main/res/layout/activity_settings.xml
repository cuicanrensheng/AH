<?xml version="1.0" encoding="utf-8"?>
<!--
设置页面布局（右侧滑出式菜单风格）
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- 左侧空白区域（点击关闭） -->
    <View
        android:id="@+id/view_outside"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true" />

    <!-- 设置面板 -->
    <ScrollView
        android:id="@+id/settings_content"
        android:layout_width="240dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/panel_bg"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <!-- 开机自启 -->
            <LinearLayout
                android:id="@+id/item_boot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:focusable="true"
                android:nextFocusUp="@+id/item_boot"
                android:nextFocusDown="@+id/item_reverse"
                android:clickable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/boot_autostart"
                        android:textColor="@color/setting_item_text_color"
                        android:textSize="16sp" />
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/sw_boot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:clickable="false" />
                </LinearLayout>
                <TextView
                    android:id="@+id/tv_boot_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/not_enabled"
                    android:textColor="@color/setting_item_text_color"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 换台反转 -->
            <LinearLayout
                android:id="@+id/item_reverse"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:focusable="true"
                android:nextFocusUp="@+id/item_boot"
                android:nextFocusDown="@+id/item_pip"
                android:clickable="true">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/channel_reverse"
                    android:textColor="@color/setting_item_text_color"
                    android:textSize="16sp" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/sw_reverse"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:clickable="false" />
            </LinearLayout>

            <!-- 画中画 -->
            <LinearLayout
                android:id="@+id/item_pip"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:focusable="true"
                android:nextFocusUp="@+id/item_reverse"
                android:nextFocusDown="@+id/item_channel_line"
                android:clickable="true">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/pip"
                    android:textColor="@color/setting_item_text_color"
                    android:textSize="16sp" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/sw_pip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:clickable="false" />
            </LinearLayout>

            <!-- 一起看（已隐藏） -->
            <LinearLayout
                android:id="@+id/item_together_watch"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:visibility="gone"
                android:focusable="false"
                android:clickable="false">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/together_watch"
                    android:textColor="@color/setting_item_text_color"
                    android:textSize="16sp" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/sw_together_watch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:clickable="false" />
            </LinearLayout>

            <!-- 频道线路选择 -->
            <LinearLayout
                android:id="@+id/item_channel_line"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:focusable="true"
                android:nextFocusUp="@+id/item_pip"
                android:nextFocusDown="@+id/item_resolution"
                android:clickable="true">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/channel_line_select"
                    android:textColor="@color/setting_item_text_color"
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/tv_channel_line"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/main_source"
                    android:textColor="@color/setting_item_text_color"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 清晰度选择 -->
            <LinearLayout
                android:id="@+id/item_resolution"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:focusable="true"
                android:nextFocusUp="@+id/item_channel_line"
                android:nextFocusDown="@+id/item_decoder"
                android:clickable="true">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/resolution_select"
                    android:textColor="@color/setting_item_text_color"
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/tv_resolution_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto"
                    android:textColor="@color/setting_item_text_color"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 解码器选择 -->
            <LinearLayout
                android:id="@+id/item_decoder"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:focusable="true"
                android:nextFocusUp="@+id/item_resolution"
                android:nextFocusDown="@+id/item_renderer"
                android:clickable="true">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/decoder_select"
                    android:textColor="@color/setting_item_text_color"
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/tv_decoder_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto"
                    android:textColor="@color/setting_item_text_color"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 渲染方式 -->
            <LinearLayout
                android:id="@+id/item_renderer"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:focusable="true"
                android:nextFocusUp="@+id/item_decoder"
                android:nextFocusDown="@+id/tv_screen_ratio"
                android:clickable="true">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/render_mode"
                    android:textColor="@color/setting_item_text_color"
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/tv_renderer_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/surface_view"
                    android:textColor="@color/setting_item_text_color"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 屏幕比例 -->
            <TextView
                android:id="@+id/tv_screen_ratio"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/screen_ratio"
                android:textColor="@color/setting_item_text_color"
                android:textSize="16sp"
                android:focusable="true"
                android:background="@drawable/item_settings_bg"
                android:nextFocusUp="@+id/item_renderer"
                android:nextFocusDown="@+id/item_redirect"
                android:clickable="true"/>

            <!-- 分隔线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="#33FFFFFF"/>

            <!-- HTTP重定向网络配置 -->
            <LinearLayout
                android:id="@+id/item_redirect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="55dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:focusable="true"
                android:nextFocusUp="@+id/tv_screen_ratio"
                android:nextFocusDown="@+id/item_live_subscribe"
                android:clickable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/http_redirect_config"
                    android:textColor="@color/setting_item_text_color"
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/tv_redirect_setting"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 分隔线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="#33FFFFFF"/>

            <!-- 直播源订阅 -->
            <LinearLayout
                android:id="@+id/item_live_subscribe"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:focusable="true"
                android:nextFocusUp="@+id/item_redirect"
                android:nextFocusDown="@+id/item_epg_subscribe"
                android:clickable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/live_source_subscribe"
                    android:textColor="@color/setting_item_text_color"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- 节目单订阅 -->
            <LinearLayout
                android:id="@+id/item_epg_subscribe"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:focusable="true"
                android:nextFocusUp="@+id/item_live_subscribe"
                android:nextFocusDown="@+id/item_check_update"
                android:clickable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/epg_subscribe"
                    android:textColor="@color/setting_item_text_color"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- 分隔线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="#33FFFFFF"/>

            <!-- 系统直播电视 (TIF) -->
            <LinearLayout
                android:id="@+id/item_tif_sync"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:focusable="true"
                android:nextFocusUp="@+id/item_epg_subscribe"
                android:nextFocusDown="@+id/item_check_update"
                android:clickable="true">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="系统直播电视"
                    android:textColor="@color/setting_item_text_color"
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/tv_tif_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="未同步"
                    android:textColor="@color/setting_item_text_color"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 检查更新 -->
            <LinearLayout
                android:id="@+id/item_check_update"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:focusable="true"
                android:nextFocusUp="@+id/item_tif_sync"
                android:nextFocusDown="@+id/item_version_info"
                android:clickable="true">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/check_update"
                    android:textColor="@color/setting_item_text_color"
                    android:textSize="16sp"/>
                <Button
                    android:id="@+id/btn_check_update"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/check_update"
                    android:focusable="false"
                    android:clickable="false"/>
            </LinearLayout>

            <!-- 版本信息 -->
            <LinearLayout
                android:id="@+id/item_version_info"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:focusable="true"
                android:nextFocusUp="@+id/item_check_update"
                android:nextFocusDown="@+id/item_debug_log"
                android:clickable="true">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/version_info"
                    android:textColor="@color/setting_item_text_color"
                    android:textSize="16sp"/>
                <TextView
                    android:id="@+id/tv_version_short"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/version_2_0"
                    android:textColor="@color/setting_item_text_color"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 🟢【新增】网络调试日志 -->
            <LinearLayout
                android:id="@+id/item_debug_log"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:focusable="true"
                android:nextFocusUp="@+id/item_version_info"
                android:nextFocusDown="@+id/item_exit_dialog"
                android:clickable="true">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/debug_log_title"
                    android:textColor="@color/setting_item_text_color"
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/tv_debug_log_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/debug_log_status_off"
                    android:textColor="@color/setting_item_text_color"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 分隔线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="#33FFFFFF"/>

            <!-- 退出弹窗 -->
            <LinearLayout
                android:id="@+id/item_exit_dialog"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:focusable="true"
                android:nextFocusUp="@+id/item_debug_log"
                android:nextFocusDown="@+id/item_exit_dialog"
                android:clickable="true">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/exit_dialog"
                    android:textColor="@color/setting_item_text_color"
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/tv_exit_dialog_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/close"
                    android:textColor="@color/setting_item_text_color"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 网页设置提示 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/web_settings_url"
                android:textColor="@color/setting_item_text_color"
                android:textSize="12sp"/>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
