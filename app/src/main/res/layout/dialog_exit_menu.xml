<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="24dp"
    android:background="@drawable/panel_bg"
    android:gravity="center_vertical"
    android:baselineAligned="false">

    <!-- 左侧：自己软件的图标 -->
    <LinearLayout
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginEnd="16dp">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@mipmap/ic_launcher"
            android:background="@drawable/player_logo_bg"
            android:contentDescription="@null"
            android:padding="12dp"
            android:scaleType="centerInside" />
    </LinearLayout>

    <!-- 右侧：按钮区域 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- 休息一会 -->
        <Button
            android:id="@+id/btn_rest"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/confirm_exit"
            android:textColor="@color/btn_text_color"
            android:textSize="16sp"
            android:background="@drawable/exit_btn_bg"
            android:layout_marginBottom="12dp"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusDown="@+id/btn_settings"
            android:nextFocusUp="@+id/btn_rest"
            android:nextFocusRight="@+id/btn_settings" />

        <!-- 设置选项 -->
        <Button
            android:id="@+id/btn_settings"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/settings_option"
            android:textColor="@color/btn_text_color"
            android:textSize="16sp"
            android:background="@drawable/exit_btn_bg"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusDown="@+id/btn_settings"
            android:nextFocusUp="@+id/btn_rest"
            android:nextFocusLeft="@+id/btn_rest" />

        <!-- 版本信息小字 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/disclaimer"
            android:textColor="#999999"
            android:textSize="11sp"
            android:gravity="center"
            android:lineSpacingExtra="4dp" />
    </LinearLayout>
</LinearLayout>  
