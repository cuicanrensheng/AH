<?xml version="1.0" encoding="utf-8"?>
<!-- 🔧 行视觉 100% 跟随 Android 原生状态：state_focused / state_selected / state_activated
     焦点态 = 浅蓝色背景 + 蓝色字体 + 【字体加粗】—— 采用"两个叠加 TextView + 原生 state color selector 互斥透明"机制：
       无焦点：下层 tv_url（normal）显示 白字常规体，上层 tv_url_bold 透明
       有焦点：下层 tv_url 透明，上层 tv_url_bold 显示 蓝字加粗体
     全程无需代码切换粗细，完全自动同步红框焦点。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="10dp"
    android:gravity="center_vertical"
    android:layout_marginBottom="4dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:descendantFocusability="afterDescendants"
    android:background="@drawable/subscription_row_content_bg">

    <!-- 内容区（勾选+名称URL）：继承根行状态，不自己拦截焦点 -->
    <LinearLayout
        android:id="@+id/content_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:focusable="false"
        android:clickable="false"
        android:duplicateParentState="true">

        <!-- ✅ 选中时的打勾标记：常驻 VISIBLE，非选中态靠 textColor=全透明 视觉"隐藏" -->
        <TextView
            android:id="@+id/tv_check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/icon_check"
            android:textColor="@color/subscription_check_text"
            android:textSize="16sp"
            android:visibility="visible"
            android:duplicateParentState="true" />

        <!-- 🔧 名称文本容器：两个 TextView 叠加（同位置同尺寸），
             duplicateParentState=true 让子节点继承 content_layout → 根行的状态变化 -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:duplicateParentState="true">

            <!-- 下层：无焦点时显示（白字 + 常规体） -->
            <TextView
                android:id="@+id/tv_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/subscription_row_text_normal"
                android:textSize="14sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:paddingTop="4dp"
                android:textStyle="normal"
                android:duplicateParentState="true" />

            <!-- 上层：有焦点时显示（蓝字 + 加粗体）
                 在代码里会再补 Paint.setFakeBoldText(true) 兜底中文 ROM bold 不生效 -->
            <TextView
                android:id="@+id/tv_url_bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/subscription_row_text_bold"
                android:textSize="14sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:paddingTop="4dp"
                android:textStyle="bold"
                android:duplicateParentState="true" />
        </FrameLayout>
    </LinearLayout>

    <!-- 📋 复制按钮：原生 subscription_action_btn_bg + subscription_action_text selector -->
    <Button
        android:id="@+id/btn_copy"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:text="@string/icon_copy"
        android:textSize="14sp"
        android:textColor="@color/subscription_action_text"
        android:background="@drawable/subscription_action_btn_bg"
        android:layout_marginEnd="8dp"
        android:focusable="true"
        android:clickable="true" />

    <!-- 🗑️ 删除按钮：同上原生 selector -->
    <Button
        android:id="@+id/btn_delete"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:text="@string/icon_delete"
        android:textSize="14sp"
        android:textColor="@color/subscription_action_text"
        android:background="@drawable/subscription_action_btn_bg"
        android:focusable="true"
        android:clickable="true" />
</LinearLayout>
