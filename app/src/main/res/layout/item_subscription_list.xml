<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginBottom="4dp"
    android:background="@android:color/transparent"
    android:focusable="false"
    android:clickable="false">

    <!-- 链接区域：打勾标记 + 地址文本 -->
    <LinearLayout
        android:id="@+id/ll_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/content_focus_selector"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:clickable="true">

        <!-- 选中时的打勾标记（未选中时隐藏） -->
        <TextView
            android:id="@+id/tv_check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/icon_check"
            android:textColor="#40A9FF"
            android:textSize="16sp"
            android:duplicateParentState="true"
            android:visibility="gone" />

        <!-- 地址文本 -->
        <TextView
            android:id="@+id/tv_url"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/tv_url_color_selector"
            android:textSize="14sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:paddingTop="4dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:duplicateParentState="true" />
    </LinearLayout>

    <!-- 复制按钮 -->
    <Button
        android:id="@+id/btn_copy"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:text="@string/icon_copy"
        android:textSize="14sp"
        android:textColor="@color/button_text_color_selector"
        android:background="@drawable/button_focus_selector"
        android:backgroundTint="@null"
        android:stateListAnimator="@null"
        android:layout_marginEnd="6dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:clickable="true" />

    <!-- 删除按钮 -->
    <Button
        android:id="@+id/btn_delete"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:text="@string/icon_delete"
        android:textSize="14sp"
        android:textColor="@color/button_text_color_selector"
        android:background="@drawable/button_focus_selector"
        android:backgroundTint="@null"
        android:stateListAnimator="@null"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:clickable="true" />
</LinearLayout>