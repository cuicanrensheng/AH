<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android12+版本继承基础主题，只覆写新增属性 -->
    <style name="Theme.TVLive.NoTitle" parent="Theme.TVLive">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <!-- 刘海屏适配：always 模式（Android 12+ 专属，横屏也能覆盖摄像头区域） -->
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
        <!-- 透明状态栏和导航栏 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- 内容延伸到系统栏后面 -->
        <item name="android:fitsSystemWindows">false</item>
        <!-- 窗口背景改成黑色，消除冷启动白屏 -->
        <item name="android:windowBackground">@android:color/black</item>
    </style>
    
    <!-- SettingsActivity 透明主题（和默认版保持一致） -->
    <style name="TransparentTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <style name="PlayerView_Surface">
        <item name="surface_type">surface_view</item>
    </style>
    <style name="PlayerView_Texture">
        <item name="surface_type">texture_view</item>
    </style>
</resources>

