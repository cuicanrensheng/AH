{
  "name": "tv-live-log-monitor",
  "version": "1.0.0",
  "description": "TV Live 日志监控工具 - 实时监控应用日志的桌面客户端",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "web": "node server.js",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:portable": "electron-builder --win portable"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3"
  },
  "keywords": [
    "android",
    "log",
    "monitor",
    "websocket",
    "tv-live"
  ],
  "author": "TV Live",
  "license": "MIT",
  "build": {
    "appId": "com.tv.live.logmonitor",
    "productName": "TV Live 日志监控",
    "directories": {
      "output": "dist9",
      "buildResources": "assets"
    },
    "files": [
      "electron/**/*",
      "server.js",
      "public/**/*",
      "platform-tools/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "platform-tools",
        "to": "platform-tools"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "signingHashAlgorithms": [],
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TV Live 日志监控",
      "perMachine": false
    }
  }
}